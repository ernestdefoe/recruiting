{
    "name": "ernestdefoe/recruiting",
    "description": "College football recruiting tracker for Flarum 2. Pulls live data from the College Football Data API (collegefootballdata.com) and displays a recruiting widget on the forum index.",
    "type": "flarum-extension",
    "keywords": ["flarum", "college football", "recruiting", "cfbd", "gridiron"],
    "homepage": "https://github.com/ernestdefoe/recruiting",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernestdefoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\Recruiting\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "FBSFB Recruiting",
            "category": "feature",
            "icon": {
                "name": "fas fa-star",
                "backgroundColor": "#B22222",
                "color": "#fff"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
